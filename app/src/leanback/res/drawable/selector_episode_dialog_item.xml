<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#0B57D0" />
            <stroke android:width="@dimen/webhtv_focus_ring_width" android:color="@color/white" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#146C2E" />
            <stroke android:width="2dp" android:color="#8EDB9F" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#99263442" />
            <stroke android:width="1dp" android:color="#44FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
